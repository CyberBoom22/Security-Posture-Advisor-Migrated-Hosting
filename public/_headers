# Cloudflare Pages response headers.
# Applied to every response; the most specific matching rule wins per header.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000

# Vite fingerprints these filenames, so they can be cached permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point must always be revalidated, or users get a stale
# index.html pointing at deleted asset hashes after a deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
